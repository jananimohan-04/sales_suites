# Copy to .env and fill in. .env is git-ignored.
PUBLIC_URL=https://your-public-address      # invitation links point here (must be reachable from the employee's phone)

# Real invitation emails (Gmail: enable 2-step verification, then create an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM="Argus Field <you@gmail.com>"

# Google sign-in (Google Cloud Console > APIs & Services > Credentials > OAuth client ID > Web application).
# Add your site address (e.g. http://localhost:3000 and PUBLIC_URL) under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
