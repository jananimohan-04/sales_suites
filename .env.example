# Copy to .env (git-ignored). On Vercel, set the same names under Project > Settings > Environment Variables.

PUBLIC_URL=https://salessuites.vercel.app      # address employees open; invitation links point here
ADMIN_EMAIL=argushexadoc2021@gmail.com         # the admin's Google account (created automatically on first start)
APP_SECRET=                                    # REQUIRED on Vercel. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
                                               # Keep it forever: it signs logins and encrypts face templates.

# Supabase (Dashboard > Project Settings > API). The secret key is server-only — never expose it.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Google sign-in (Web application OAuth client; add your site address under Authorized JavaScript origins)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Invitation emails (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=argushexadoc2021@gmail.com
SMTP_PASS=

# Optional
# GOOGLE_MAPS_API_KEY=
# ALLOW_SIMULATION=false      # true only while testing without travelling
